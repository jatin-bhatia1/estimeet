{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev: api",
      "type": "shell",
      "command": "go run ./cmd/server",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "group": "dev", "panel": "dedicated" }
    },
    {
      "label": "dev: web",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "group": "dev", "panel": "dedicated" }
    },
    {
      "label": "dev",
      "dependsOn": ["dev: api", "dev: web"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "test: backend",
      "type": "shell",
      "command": "go test ./...",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "build: frontend",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "test: smoke",
      "type": "shell",
      "command": "pwsh -NoProfile -File ./scripts/smoke.ps1",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
