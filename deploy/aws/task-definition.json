{
  "_comment": [
    "ECS task definition for Estimeet on Fargate. Replace <account>, <region>,",
    "fs-<id> and fsap-<id>, then: aws ecs register-task-definition --cli-input-json file://deploy/aws/task-definition.json",
    "Run it as a service with desiredCount 1 behind an Application Load Balancer.",
    "Two tasks must never run at once: the board is broadcast from memory and the",
    "database is a single SQLite file, so set the deployment configuration to",
    "minimumHealthyPercent 0 / maximumPercent 100 and accept a few seconds of",
    "downtime on deploy.",
    "To use Aurora Serverless v2 (PostgreSQL) instead of the SQLite file, add",
    "ESTIMEET_DB_URL as a secret from Secrets Manager and drop the EFS volume,",
    "mountPoints and the task role. One task is still the limit, because the",
    "board is broadcast from memory."
  ],
  "family": "estimeet",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "256",
  "memory": "512",
  "runtimePlatform": {
    "cpuArchitecture": "ARM64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::<account>:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::<account>:role/estimeet-task",
  "volumes": [
    {
      "name": "data",
      "efsVolumeConfiguration": {
        "fileSystemId": "fs-<id>",
        "transitEncryption": "ENABLED",
        "authorizationConfig": {
          "accessPointId": "fsap-<id>",
          "iam": "ENABLED"
        }
      }
    }
  ],
  "containerDefinitions": [
    {
      "name": "api",
      "image": "<account>.dkr.ecr.<region>.amazonaws.com/estimeet:main",
      "essential": true,
      "portMappings": [
        {
          "name": "http",
          "containerPort": 8090,
          "protocol": "tcp"
        }
      ],
      "mountPoints": [
        {
          "sourceVolume": "data",
          "containerPath": "/data",
          "readOnly": false
        }
      ],
      "environment": [
        {
          "name": "ESTIMEET_ALLOWED_ORIGINS",
          "value": "https://jatin-bhatia1.github.io"
        },
        {
          "name": "ESTIMEET_APP_BASE_URL",
          "value": "https://jatin-bhatia1.github.io/estimeet"
        },
        {
          "name": "ESTIMEET_ISSUES_URL",
          "value": "https://github.com/jatin-bhatia1/estimeet/issues/new/choose"
        },
        {
          "name": "ESTIMEET_CONTACT_EMAIL",
          "value": ""
        }
      ],
      "secrets": [
        {
          "name": "ESTIMEET_SECRET",
          "valueFrom": "arn:aws:secretsmanager:<region>:<account>:secret:estimeet/secret"
        }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "wget -q -O - http://127.0.0.1:8090/api/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 10
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/estimeet",
          "awslogs-region": "<region>",
          "awslogs-stream-prefix": "api",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
